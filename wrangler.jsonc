// Retired 2026-11-06: the Reel Nest policy pages moved to the company site repository
// (fellow-survivor-studio.github.io, sources/reel-nest/), served at
// https://fellowsurvivor.com/products/reel-nest/privacy/ and /terms/.
// The Cloudflare project fellowsurvivor-reel-nest no longer has routes or automatic builds;
// the old /reel-nest/... addresses are forwarded by the company site's _redirects rules.
{
  "name": "fellowsurvivor-reel-nest",
  "compatibility_date": "2026-11-01",
  "build": { "command": "sh scripts/cloudflare-build.sh" },
  "assets": {
    "directory": "./.cf-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": false
}
