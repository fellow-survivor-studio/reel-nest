// Cloudflare Workers static hosting for https://fellowsurvivor.com/reel-nest/
// Runs alongside GitHub Pages until the switch.
{
  "name": "fellowsurvivor-reel-nest",
  "compatibility_date": "2026-11-01",
  // Copies the published files into .cf-dist/reel-nest/ so they are served under /reel-nest/.
  "build": { "command": "sh scripts/cloudflare-build.sh" },
  "assets": {
    "directory": "./.cf-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": true,
  // Branch and pull-request previews (wrangler preview needs this block, even empty).
  "previews": {},
  // fellowsurvivor.com is served by Cloudflare since 2026-11-06 (GitHub Pages stays on to
  // forward the github.io addresses). new.fellowsurvivor.com is the test address.
  "routes": [
    // Exact /reel-nest (redirects to /reel-nest/) and everything under /reel-nest/ only, so the main
    // site's files that merely start with "reel-nest" (e.g. /reel-nest.css) stay with the main site.
    { "pattern": "new.fellowsurvivor.com/reel-nest", "zone_name": "fellowsurvivor.com" },
    { "pattern": "new.fellowsurvivor.com/reel-nest/*", "zone_name": "fellowsurvivor.com" },
    { "pattern": "fellowsurvivor.com/reel-nest", "zone_name": "fellowsurvivor.com" },
    { "pattern": "fellowsurvivor.com/reel-nest/*", "zone_name": "fellowsurvivor.com" }
  ]
}
